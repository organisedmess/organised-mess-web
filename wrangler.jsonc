{
	// Cloudflare Workers — static site in ./site with a tiny Worker (worker.js)
	// that serves the Capabilities deep link and the contact form endpoint.
	// _headers in site/ are honoured.
	"name": "organised-mess-web",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	// outbound email via Resend (the domain's mail lives on Google Workspace, so Cloudflare Email
	// Routing is not an option — it would replace the MX records). Secrets, set in the dashboard:
	// RESEND_API_KEY and TURNSTILE_SECRET. The sender is on the send. subdomain verified in Resend.
	"vars": {
		"CONTACT_TO": "matthew@organisedmess.studio",
		"CONTACT_FROM": "Organised Mess website <noreply@send.organisedmess.studio>"
	}
}
