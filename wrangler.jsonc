{
	// Cloudflare Workers — static site in ./site with a tiny Worker (worker.js)
	// that serves the Capabilities deep link, the contact form endpoint and the /internal login.
	// _headers in site/ are honoured.
	"name": "organised-mess-web",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Every request runs worker.js first. It has to: the internal area is on its own host
		// (internal.organisedmess.studio, a custom domain on this Worker) where any path may be login-gated,
		// so no file may be served straight from the asset cache. Public pages are passed on to the assets.
		"run_worker_first": true
	},
	// outbound email: SMTP to Google Workspace from the Worker, as GMAIL_USER. Secrets set in the
	// dashboard (never here): GMAIL_APP_PASSWORD, TURNSTILE_SECRET.
	"vars": {
		"GMAIL_USER": "matthew@organisedmess.studio",
		"CONTACT_TO": "matthew@organisedmess.studio"
	},
	// TOOLS_KV: /internal/tools locations, conditions and notes (worker.js → /internal/tools/api/state)
	"kv_namespaces": [
		{
			"binding": "TOOLS_KV",
			"id": "042433a2ee98480f948c82b3ff607a2f",
			"remote": true
		}
	],
	// ADMIN: the private admin Worker (quotations, invoices, letters). It has no public address;
	// worker.js passes /internal/admin/* to it once the /internal login has been checked.
	"services": [
		{
			"binding": "ADMIN",
			"service": "organised-mess-admin"
		}
	]
}